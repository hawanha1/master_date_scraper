# Copy to config.env and fill in.  (config.env is private: never commit it)

# Gmail account that sends the report, and its 16-character App Password
# (Google Account > Security > 2-Step Verification ON > App passwords)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Who receives the report (comma-separated). Defaults to GMAIL_ADDRESS.
NOTIFY_TO=you@gmail.com

# Report a "deadline coming" window if the deadline is within this many days
DEADLINE_DAYS=30
# Report an "opened recently" window (no closing date on the page) for this many days
OPENED_DAYS=45
# Send an email even when nothing was found (true/false)
SEND_WHEN_EMPTY=false

# Speed / depth
WORKERS=12
MAX_PAGES=12
SHEETS=italy_universities.xlsx,germany_universities.xlsx

# Optional proxy rotation, comma-separated, e.g. http://user:pass@host:port
PROXIES=

# Obey each site's robots.txt (RFC 9309) incl. Crawl-delay. Keep true.
RESPECT_ROBOTS=true
